-- Розрахунок Canvas
local function recalculateCanvas()
    local teamCount = #TeamsListContainer:GetChildren() - 1
    local playerCount = #PlayersListContainer:GetChildren() - 1
    if teamCount < 0 then teamCount = 0 end
    if playerCount < 0 then playerCount = 0 end
    
    TeamsListContainer.Size = UDim2.new(0.98, 0, 0, teamCount * 34)
    PlayersListContainer.Size = UDim2.new(0.98, 0, 0, playerCount * 34)
    
    CombatFrame.CanvasSize = UDim2.new(0, 0, 0, 310 + (teamCount * 34) + (playerCount * 34))
end

local updatePlayerList

local function updateTeamList()
    for _, child in ipairs(TeamsListContainer:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local serverTeams = Teams:GetTeams()
    if #serverTeams == 0 then
        local emptyLabel = Instance.new("Frame")
        emptyLabel.Parent = TeamsListContainer
        emptyLabel.Size = UDim2.new(1, 0, 0, 25)
        emptyLabel.BackgroundTransparency = 1
        
        local txt = Instance.new("TextLabel")
        txt.Parent = emptyLabel
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.Text = "  Команди не знайдені в цій грі"
        txt.TextColor3 = Color3.fromRGB(150, 150, 150)
        txt.TextSize = 10
        txt.TextXAlignment = Enum.TextXAlignment.Left
    else
        for _, t in ipairs(serverTeams) do
            local tFrame = Instance.new("Frame")
            tFrame.Parent = TeamsListContainer
            tFrame.Size = UDim2.new(1, 0, 0, 30)
            tFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
            tFrame.BackgroundTransparency = 0.4

            local tCorner = Instance.new("UICorner")
            tCorner.CornerRadius = UDim.new(0, 4)
            tCorner.Parent = tFrame

            local tNameLabel = Instance.new("TextLabel")
            tNameLabel.Parent = tFrame
            tNameLabel.Size = UDim2.new(0.65, 0, 1, 0)
            tNameLabel.BackgroundTransparency = 1
            tNameLabel.Text = "  " .. t.Name
            tNameLabel.TextColor3 = t.TeamColor and t.TeamColor.Color or Color3.fromRGB(255, 255, 255)
            tNameLabel.TextSize = 11
            tNameLabel.TextXAlignment = Enum.TextXAlignment.Left

            local tIgnoreBtn = Instance.new("TextButton")
            tIgnoreBtn.Parent = tFrame
            tIgnoreBtn.Position = UDim2.new(0.68, 0, 0.15, 0)
            tIgnoreBtn.Size = UDim2.new(0.28, 0, 0.7, 0)
            tIgnoreBtn.TextSize = 10
            tIgnoreBtn.BackgroundTransparency = 0.3

            local btnC = Instance.new("UICorner")
            btnC.CornerRadius = UDim.new(0, 4)
            btnC.Parent = tIgnoreBtn

            if IgnoredTeams[t.Name] then
                tIgnoreBtn.Text = "Unignore"
                tIgnoreBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
            else
                tIgnoreBtn.Text = "Ignore"
                tIgnoreBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 40)
            end
            tIgnoreBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

            tIgnoreBtn.MouseButton1Click:Connect(function()
                local shouldIgnore = not IgnoredTeams[t.Name]
                IgnoredTeams[t.Name] = shouldIgnore or nil
                
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Team == t then
                        IgnoredPlayers[p.UserId] = shouldIgnore or nil
                    end
                end

                updateTeamList()
                if updatePlayerList then updatePlayerList() end
            end)
        end
    end
    recalculateCanvas()
end

