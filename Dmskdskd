local function getGuiParent()
    local parent = nil
    pcall(function()
        if gethui then
            parent = gethui()
        elseif game:GetService("CoreGui") then
            parent = game:GetService("CoreGui")
        end
    end)
    if not parent then
        parent = LocalPlayer:WaitForChild("PlayerGui", 5)
    end
    return parent
end

