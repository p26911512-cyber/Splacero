-- Обновление Меню Игнора
local function refreshIgnoreList()
    for _, child in ipairs(IgnoreScroll:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    -- СЕКЦИЯ КОМАНД
    local teamHeader = Instance.new("TextLabel")
    teamHeader.Parent = IgnoreScroll
    teamHeader.Size = UDim2.new(0.98, 0, 0, 20)
    teamHeader.Text = "-- IGNORE TEAMS --"
    teamHeader.TextColor3 = Color3.fromRGB(180, 180, 255)
    teamHeader.BackgroundTransparency = 1
    teamHeader.TextSize = 10

    for _, team in ipairs(Teams:GetTeams()) do
        local isIgnored = IgnoredTeams[team.Name] or false
        local btn = createOptionBtn(
            IgnoreScroll, 
            "Team: " .. team.Name .. (isIgnored and " [IGNORED]" or " [OK]"), 
            isIgnored and Color3.fromRGB(160, 40, 40) or Color3.fromRGB(40, 100, 40)
        )
        btn.MouseButton1Click:Connect(function()
            IgnoredTeams[team.Name] = not IgnoredTeams[team.Name]
            refreshIgnoreList()
        end)
    end

    -- СЕКЦИЯ ИГРОКОВ
    local playerHeader = Instance.new("TextLabel")
    playerHeader.Parent = IgnoreScroll
    playerHeader.Size = UDim2.new(0.98, 0, 0, 20)
    playerHeader.Text = "-- INDIVIDUAL PLAYERS --"
    playerHeader.TextColor3 = Color3.fromRGB(180, 180, 255)
    playerHeader.BackgroundTransparency = 1
    playerHeader.TextSize = 10

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local isTeamIgnored = player.Team and IgnoredTeams[player.Team.Name]
            local isForceUnignored = ForceUnignoredPlayers[player.UserId] or false
            local isIndividuallyIgnored = IgnoredPlayers[player.UserId] or false

            local btnText = player.Name
            local btnColor = Color3.fromRGB(30, 30, 45)

            if isForceUnignored then
                btnText = player.Name .. " [FORCE UNIGNORE]"
                btnColor = Color3.fromRGB(40, 160, 40)
            elseif isTeamIgnored then
                btnText = player.Name .. " [TEAM IGNORED]"
                btnColor = Color3.fromRGB(120, 40, 40)
            elseif isIndividuallyIgnored then
                btnText = player.Name .. " [IGNORED]"
                btnColor = Color3.fromRGB(160, 40, 40)
            else
                btnText = player.Name .. " [OK]"
            end

            local btn = createOptionBtn(IgnoreScroll, btnText, btnColor)
            btn.MouseButton1Click:Connect(function()
                if isTeamIgnored then
                    ForceUnignoredPlayers[player.UserId] = not ForceUnignoredPlayers[player.UserId]
                else
                    IgnoredPlayers[player.UserId] = not IgnoredPlayers[player.UserId]
                end
                refreshIgnoreList()
            end)
        end
    end
end

Players.PlayerAdded:Connect(refreshIgnoreList)
