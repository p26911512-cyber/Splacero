local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

if PlayerGui:FindFirstChild("MobileMenu") then
    PlayerGui.MobileMenu:Destroy()
end

local ScreenGui = Instance.new("ScreenGui", PlayerGui)
ScreenGui.Name = "MobileMenu"
ScreenGui.ResetOnSpawn = false

-- Чорний водяний знак (зникає через 10 секунд)
local Watermark = Instance.new("TextLabel", ScreenGui)
Watermark.Size = UDim2.new(0, 300, 0, 30)
Watermark.Position = UDim2.new(0.5, -150, 0, 5)
Watermark.BackgroundTransparency = 1
Watermark.TextColor3 = Color3.fromRGB(0, 0, 0)
Watermark.TextSize = 14
Watermark.Font = Enum.Font.SourceSansBold
Watermark.Text = "script ot splacero (war military)"

task.spawn(function()
