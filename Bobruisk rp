-- Безпечна перевірка видимості через Raycast
local function isVisible(targetPart, character)
    local localCharacter = LocalPlayer.Character
    if not localCharacter then return false end
    
    local originPart = localCharacter:FindFirstChild("Head") or localCharacter:FindFirstChild("HumanoidRootPart")
    if not originPart then return false end
    
    local origin = originPart.Position
    local direction = targetPart.Position - origin
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {localCharacter, character}
    raycastParams.IgnoreWater = true
    
    local success, result = pcall(function()
        return workspace:Raycast(origin, direction, raycastParams)
    end)
    
    if not success then return true end
    return result == nil
end

-- Створення ESP підсвічування
local function createTeamHighlight(player, character)
    local highlight = Instance.new("Highlight")
    highlight.Name = "BypassedHighlight"
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.3
    highlight.OutlineTransparency = 0
    
    pcall(function()
        highlight.Parent = gethui()
    end)
    if not highlight.Parent then
        highlight.Parent = character
    end
    
    EspDrawings[character] = highlight
end

-- Головний цикл
RunService.RenderStepped:Connect(function()
    local targetPart = nil
    local shortestDistance = math.huge
    local closestPlayerName = "Немає"
    local closestDistVal = "-"
    local localCharacter = LocalPlayer.Character
    local localRootPos = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart") and localCharacter.HumanoidRootPart.Position or nil

    if EspEnabled and localRootPos then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local character = player.Character
                local humanoid = character and character:FindFirstChild("Humanoid")
                local rootPart = character and character:FindFirstChild("HumanoidRootPart")

                if character and humanoid and humanoid.Health > 0 and rootPart then
                    local dist = math.floor((rootPart.Position - localRootPos).Magnitude)
                    if dist <= MaxDistance then
                        if not EspDrawings[character] or not EspDrawings[character].Parent then
                            createTeamHighlight(player, character)
                        end
                    else
                        if EspDrawings[character] then
                            EspDrawings[character]:Destroy()
                            EspDrawings[character] = nil
                        end
                    end
                else
                    if character and EspDrawings[character] then
                        EspDrawings[character]:Destroy()
                        EspDrawings[character] = nil
                    end
                end
            end
        end
    else
        ClearEsp()
    end

    if localRootPos then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                
                local playerTeamName = player.Team and player.Team.Name or nil
                local isTeamIgnored = playerTeamName and IgnoredTeams[playerTeamName]
                local isPlayerIgnored = SpecificIgnoredPlayers[player]

                local canTarget = true
                if ForcedTargetPlayers[player] then
                    canTarget = true
                elseif isPlayerIgnored or isTeamIgnored then
                    canTarget = false
                end

                if canTarget then
                    local part = player.Character:FindFirstChild(AimPart)
                    if part then
                        if isVisible(part, player.Character) then
                            local distanceToPlayer = (part.Position - localRootPos).Magnitude
                            if distanceToPlayer <= MaxDistance then
                                local screenPoint, onScreen = Camera:WorldToViewportPoint(part.Position)
                                if onScreen then
                                    local mouse = UserInputService:GetMouseLocation()
                                    local screenDistance = (Vector2.new(screenPoint.X, screenPoint.Y) - mouse).Magnitude

                                    if screenDistance < shortestDistance then
                                        shortestDistance = screenDistance
                                        targetPart = part
                                        closestPlayerName = player.Name
                                        closestDistVal = math.floor(distanceToPlayer) .. " м"
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    InfoBox.Text = string.format("Ціль: %s\nДистанція: %s\nAimbot: %s\nSafe ESP: %s", closestPlayerName, closestDistVal, AimbotEnabled and "ON" or "OFF", EspEnabled and "ON" or "OFF")

    if AimbotEnabled and targetPart then
        local currentCFrame = Camera.CFrame
        local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        Camera.CFrame = currentCFrame:Lerp(targetCFrame, Sensitivity)
    end
end)
