RefreshLists = function()
    for _, child in ipairs(ListContainer:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local count = 0
    local filterText = string.lower(NameInputBox.Text)

    if SelectedTab == "Teams" then
        local foundTeams = {}
        for _, team in ipairs(Teams:GetTeams()) do foundTeams[team.Name] = true end
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Team then foundTeams[player.Team.Name] = true end
        end

        for teamName, _ in pairs(foundTeams) do
            if filterText == "" or string.find(string.lower(teamName), filterText) then
                count = count + 1
                local btn = Instance.new("TextButton")
                btn.Parent = ListContainer
                btn.Size = UDim2.new(1, -4, 0, 22)
                btn.Font = Enum.Font.SourceSansBold
                btn.TextSize = 10

                if IgnoredTeams[teamName] then
                    btn.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
                    btn.TextColor3 = Color3.fromRGB(255, 100, 100)
                    btn.Text = "[Ігнор] " .. teamName
                else
                    btn.BackgroundColor3 = Color3.fromRGB(20, 60, 20)
                    btn.TextColor3 = Color3.fromRGB(100, 255, 100)
                    btn.Text = "[Ціль] " .. teamName
                end

                btn.MouseButton1Click:Connect(function()
                    IgnoredTeams[teamName] = not IgnoredTeams[teamName] and true or nil
                    RefreshLists()
                end)
            end
        end
    elseif SelectedTab == "Players" then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if filterText == "" or string.find(string.lower(player.Name), filterText) then
                    count = count + 1
                    local btn = Instance.new("TextButton")
                    btn.Parent = ListContainer
                    btn.Size = UDim2.new(1, -4, 0, 22)
                    btn.Font = Enum.Font.SourceSansBold
                    btn.TextSize = 10

                    local playerTeamName = player.Team and player.Team.Name or nil
                    local isTeamIgnored = playerTeamName and IgnoredTeams[playerTeamName]
                    
                    local isIgnored = false
                    if ForcedTargetPlayers[player] then
                        isIgnored = false
                    elseif SpecificIgnoredPlayers[player] or isTeamIgnored then
                        isIgnored = true
                    end

                    if isIgnored then
                        btn.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
                        btn.TextColor3 = Color3.fromRGB(255, 100, 100)
                        btn.Text = "[Ігнор] " .. player.Name
                    else
                        btn.BackgroundColor3 = Color3.fromRGB(20, 60, 20)
                        btn.TextColor3 = Color3.fromRGB(100, 255, 100)
                        btn.Text = "[Ціль] " .. player.Name
                    end

                    btn.MouseButton1Click:Connect(function()
                        if isIgnored then
                            if SpecificIgnoredPlayers[player] then SpecificIgnoredPlayers[player] = nil end
                            if isTeamIgnored then ForcedTargetPlayers[player] = true end
                        else
                            if ForcedTargetPlayers[player] then ForcedTargetPlayers[player] = nil end
                            if not isTeamIgnored then SpecificIgnoredPlayers[player] = true end
                        end
                        RefreshLists()
                    end)
                end
            end
        end
    end

    ListContainer.CanvasSize = UDim2.new(0, 0, 0, count * 25)
end

